-- Função que simula a tecla LeftControl (o Fluent já entende essa tecla)
local function ToggleMenu()
    -- Simula pressionar LeftControl
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.LeftControl, false, game)
    task.wait(0.05)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.LeftControl, false, game)
    
    -- Feedback visual (alterna a cor do botão)
    if UIStroke.Color == Color3.fromRGB(200, 50, 200) then
        UIStroke.Color = Color3.fromRGB(100, 100, 100)
        FloatingBtn.BackgroundColor3 = Color3.fromRGB(60, 20, 60)
    else
        UIStroke.Color = Color3.fromRGB(200, 50, 200)
        FloatingBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    end
end

-- // ==========================================
-- // ARRASTAR E CLICAR
-- // ==========================================

local dragging = false
local dragStart, startPos
local tempoClique = 0
local moveuMuito = false

FloatingBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = FloatingBtn.Position
        tempoClique = tick()
        moveuMuito = false
    end
end)

FloatingBtn.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
        local duracao = tick() - tempoClique
        if duracao < 0.5 and not moveuMuito then
            ToggleMenu()
        end
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        if (input.Position - dragStart).Magnitude > 5 then
            moveuMuito = true
        end
        FloatingBtn.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

