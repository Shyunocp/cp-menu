-- // 9. FUNÇÕES DO AUTO STAR
-- // ==========================================

local function TeleportarParaEstrela(estrela)
    if estrela and hrp and estrela.Parent then
        hrp.CFrame = CFrame.new(estrela.Position) + Vector3.new(0, 3, 0)
        estrelaPega = true
        Fluent:Notify({Title = "⭐ Estrela Pega!", Content = "Você pegou a estrela!", Duration = 3})
        task.wait(0.5)
        estrelaPega = false
    end
end

local function VerificarEstrela()
    local estrela = Workspace:FindFirstChild("Star")
    if estrela and estrela:IsA("BasePart") then return estrela end
    return nil
end

local function IniciarAutoStar()
    local estrelaInicial = VerificarEstrela()
    if estrelaInicial then TeleportarParaEstrela(estrelaInicial) end
    
    Workspace.ChildAdded:Connect(function(child)
        if starAtivo and child.Name == "Star" and child:IsA("BasePart") then
            task.wait(0.1)
            TeleportarParaEstrela(child)
        end
    end)
    
    spawn(function()
        while starAtivo do
            if not estrelaPega then
                local estrela = VerificarEstrela()
                if estrela then TeleportarParaEstrela(estrela) end
            end
            task.wait(0.3)
        end
    end)
end

-- // ==========================================
-- // 10. FUNÇÃO DE FLY
-- // ==========================================

local function IniciarFly()
    if conexaoFly then conexaoFly:Disconnect() end
    
    local bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity.Parent = hrp
    
    local bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bodyGyro.P = 1000
    bodyGyro.D = 50
    bodyGyro.Parent = hrp
    
    conexaoFly = RunService.Heartbeat:Connect(function()
        if not flyAtivo or not hrp then return end
        
        local direcao = Vector3.new(0, 0, 0)
        local velocidade = 80
        
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            direcao = direcao + camera.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            direcao = direcao - camera.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            direcao = direcao - camera.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            direcao = direcao + camera.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            direcao = direcao + Vector3.new(0, 1, 0)
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
            direcao = direcao - Vector3.new(0, 1, 0)
        end
        
        if direcao.Magnitude > 0 then
            bodyVelocity.Velocity = direcao.Unit * velocidade
        else
            bodyVelocity.Velocity = Vector3.new(0, 0, 0)
        end
        
        bodyGyro.CFrame = camera.CFrame
    end)
end

local function PararFly()
    flyAtivo = false
    if conexaoFly then conexaoFly:Disconnect() end
    if hrp then
        for _, obj in pairs(hrp:GetChildren()) do
            if obj:IsA("BodyVelocity") or obj:IsA("BodyGyro") then
                obj:Destroy()
            end
        end
    end
end

