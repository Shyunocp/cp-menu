local estrelaPega = false

local NomeDaTool = "caixa"
local NomePegar = "GetJobPart"
local NomeEntregar = "TrabalhoBar"

-- // ==========================================
-- // 8. FUNÇÕES DO FARM
-- // ==========================================

local function AtivarNoClip()
    if conexaoNoClip then conexaoNoClip:Disconnect() end
    conexaoNoClip = RunService.Stepped:Connect(function()
        if noClipAtivo and char then
            for _, parte in pairs(char:GetDescendants()) do
                if parte:IsA("BasePart") and parte.Name ~= "HumanoidRootPart" and parte.CanCollide then
                    parte.CanCollide = false
                end
            end
        end
    end)
end

local function ApertarPrompt(prompt)
    if prompt and prompt:IsA("ProximityPrompt") then
        prompt:InputHoldBegin()
        task.wait(0.05)
        prompt:InputHoldEnd()
    end
end

local function TemCaixa()
    return char:FindFirstChild(NomeDaTool) or player.Backpack:FindFirstChild(NomeDaTool)
end

local function IniciarFarm()
    spawn(function()
        while farmAtivo do
            if TemCaixa() then
                local pontoDeEntrega = Workspace:FindFirstChild(NomeEntregar, true)
                if pontoDeEntrega then
                    local targetPart = pontoDeEntrega:FindFirstChild("TargetPart")
                    local destino = targetPart or pontoDeEntrega
                    local posicaoExata = destino.Position
                    hrp.CFrame = CFrame.new(posicaoExata) + Vector3.new(0, 2, 0)
                    task.wait(0.05)
                    local tempoLimite = tick() + 3
                    local angulo = 0
                    while TemCaixa() and tick() < tempoLimite and farmAtivo do
                        angulo = angulo + 0.8
                        local raio = 0.8
                        local offsetX = math.cos(angulo) * raio
                        local offsetZ = math.sin(angulo) * raio
                        hrp.CFrame = CFrame.new(posicaoExata + Vector3.new(offsetX, 2, offsetZ))
                        task.wait(0.03)
                    end
                end
            else
                local pontoDePegar = Workspace:FindFirstChild(NomePegar, true)
                if pontoDePegar then
                    hrp.CFrame = CFrame.new(pontoDePegar.Position) + Vector3.new(0, 2, 0)
                    task.wait(0.05)
                    local prompt = pontoDePegar:FindFirstChildOfClass("ProximityPrompt")
                    if prompt then ApertarPrompt(prompt) end
                    local tempoLimite = tick() + 1
                    while not TemCaixa() and tick() < tempoLimite and farmAtivo do
                        task.wait(0.05)
                    end
                end
            end
            task.wait(0.05)
        end
    end)
end

