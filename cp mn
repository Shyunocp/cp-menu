local jogadorSelecionado = nil
local espectando = false
local conexaoEspectador = nil

local function AtualizarListaJogadores()
    local lista = {}
    for _, jog in pairs(Players:GetPlayers()) do
        if jog ~= player then
            table.insert(lista, jog.Name)
        end
    end
    return lista
end

local function GetJogadorPorNome(nome)
    for _, jog in pairs(Players:GetPlayers()) do
        if jog.Name == nome then return jog end
    end
    return nil
end

local function TeleportarParaJogador(nome)
    local alvo = GetJogadorPorNome(nome)
    if alvo and alvo.Character and hrp then
        local alvoHrp = alvo.Character:FindFirstChild("HumanoidRootPart")
        if alvoHrp then
            hrp.CFrame = alvoHrp.CFrame + Vector3.new(0, 3, 3)
            Fluent:Notify({Title = "👥 Teleporte", Content = "Teleportado para " .. nome, Duration = 3})
        end
    end
end

local function IniciarEspectador(nome)
    local alvo = GetJogadorPorNome(nome)
    if not alvo then
        Fluent:Notify({Title = "👁 Espectador", Content = "Jogador não encontrado!", Duration = 3})
        return
    end
    
    espectando = true
    if conexaoEspectador then conexaoEspectador:Disconnect() end
    
    conexaoEspectador = RunService.RenderStepped:Connect(function()
        if espectando and alvo.Character then
            local alvoHead = alvo.Character:FindFirstChild("Head")
            if alvoHead then
                camera.CameraSubject = alvoHead
                camera.CameraType = Enum.CameraType.Custom
            end
        else
            if char and char:FindFirstChild("Humanoid") then
                camera.CameraSubject = char.Humanoid
            end
            espectando = false
            if conexaoEspectador then conexaoEspectador:Disconnect() end
        end
    end)
    
    Fluent:Notify({Title = "👁 Espectador", Content = "Espectando: " .. nome, Duration = 3})
end

local function PararEspectador()
    espectando = false
    if conexaoEspectador then conexaoEspectador:Disconnect() end
    if char and char:FindFirstChild("Humanoid") then
        camera.CameraSubject = char.Humanoid
        camera.CameraType = Enum.CameraType.Custom
    end
    Fluent:Notify({Title = "👁 Espectador", Content = "Espectador desligado!", Duration = 3})
end

local function PuxarJogador(nome)
    local alvo = GetJogadorPorNome(nome)
    if not alvo or not alvo.Character or not hrp then
        Fluent:Notify({Title = "🪝 Puxar", Content = "Jogador não encontrado!", Duration = 3})
        return
    end
    
    local alvoHrp = alvo.Character:FindFirstChild("HumanoidRootPart")
    if not alvoHrp then return end
    
    spawn(function()
        local tempoLimite = tick() + 3
        while tick() < tempoLimite and alvo.Character and alvo.Character:FindFirstChild("HumanoidRootPart") do
            local alvoHrpAtual = alvo.Character.HumanoidRootPart
            
            local bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            
            local direcao = (hrp.Position - alvoHrpAtual.Position).Unit
            bv.Velocity = direcao * 100
            
            bv.Parent = alvoHrpAtual
            task.wait(0.1)
            bv:Destroy()
        end
    end)
    
    Fluent:Notify({Title = "🪝 Puxar", Content = "Puxando " .. nome .. "...", Duration = 3})
end

